{
  "name": "vibe-chords",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "build": "next build --webpack",
    "start": "next start",
    "start:pi": "next start --hostname 0.0.0.0 --port 3100",
    "eval:models": "node --conditions=react-server --import tsx evals/run.ts",
    "check:floor": "node scripts/floor-guard.mjs",
    "check:secrets": "gitleaks detect --redact --no-banner",
    "check:security": "semgrep scan --config p/default --config p/owasp-top-ten --severity ERROR --severity WARNING --error app components lib",
    "check:deps": "node scripts/check-deps.mjs",
    "coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=lib/** --coverage.include=app/** --coverage.include=components/**",
    "check:coverage": "node scripts/check-diff-coverage.mjs",
    "check:fast": "npm run check:floor && npm run typecheck && npm run lint && npm run check:secrets",
    "check:task": "npm run check:fast && npm run check:coverage && npm run check:security && npm run check:deps"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "better-sqlite3": "^13.0.3",
    "client-only": "0.0.1",
    "gsap": "^3.15.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tone": "15.1.22",
    "vexchords": "^1.2.0",
    "vextab": "4.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "5.0.3"
  }
}
